{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "#components/*": ["./src/components/*"],
      "#components": ["./src/components"],
      "#screens/*": ["./src/screens/*"],
      "#screens": ["./src/screens"],
      "#store/*": ["./src/store/*"],
      "#store": ["./src/store"],
      "#hooks/*": ["./src/hooks/*"],
      "#hooks": ["./src/hooks"],
      "#constants/*": ["./src/constants/*"],
      "#constants": ["./src/constants"],
      "#shared/*": ["../desktop/src/constants/*"],
      "#shared": ["../desktop/src/constants"],
      "#assets/*": ["./public/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
